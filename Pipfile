[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[requires]
python_version = "3.14"

[packages]
alembic = "~=1.20"
asyncpg = "~=0.31"
beautifulsoup4 = "~=4.15"
cryptography = "~=50.0"
curl-cffi = "~=0.16.3"
fastapi = "~=0.141"
fastapi-users = { extras = ["sqlalchemy"], version = "~=15.0" }
fastapi-users-db-sqlalchemy = "~=7.0"
google-genai = "~=2.24"
httptools = { version = "==0.8.0", markers = "sys_platform != 'win32' or platform_machine == 'AMD64'" }
lxml = "~=6.1"
openai = "~=3.20"
pandas = "~=3.0"
prometheus-client = "==0.26.0"
psutil = "~=7.2"
python-dotenv = "~=1.2"
python-multipart = "~=0.0"
setuptools = "~=84.0"
slowapi = "~=0.1"
sqlalchemy = "~=2.0"
tabulate = "~=0.10"
toon-format = "==0.9.0b1"
tradingview-datafeed = "~=2.1"
uvicorn = "~=0.54"
uvloop = { version = "==0.23.0", markers = "sys_platform != 'win32'" }
watchfiles = "~=1.2"
websockets = "~=16.1"
yfinance = "~=1.7"

[dev-packages]
coverage = "~=7.16"
httpx2 = "~=2.13"
pandas-stubs = "~=3.0"
pre-commit = "~=4.6"
pyright = "~=1.1"
ruff = "~=0.16"
types-tabulate = "~=0.10"

[pipenv]
allow_prereleases = false

[scripts]
app = "python -m app.main"
app-cli = "python -m app.main --cli"
build-frontend = "cd app/frontend && npm install && npm run build"
build-gh-pages = "cd app/frontend && npm install && npm run build:gh-pages"
docker-up = "python scripts/docker_up.py -d --build"
test = "python -m unittest discover"
cov = "python scripts/cov.py"
test-frontend = "cd app/frontend && npm test"
update = "python -m database.updater"
regenerate = "python scripts/regenerate_reports.py"
gen-golden = "python scripts/gen_analysis_golden.py"
gen-strategy = "python scripts/gen_strategy_performance.py"
gen-fund-performance = "python scripts/gen_fund_performance.py"
gen-splits = "python scripts/gen_splits.py"
check-filings = "python scripts/check_filings.py"
lint = "ruff check ."
lint-fix = "ruff check --fix ."
format = "ruff format ."
pyright = "pyright"
